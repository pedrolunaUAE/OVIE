# Copiar a .env y completar. NO subir .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=ovie
POSTGRES_USER=ovie
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
POSTGRES_PORT=5432

# --- Correo (opcional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Puertos publicados en Windows ---
CLIENT_PORT=80
BACKEND_PORT=8080

# --- Origen permitido por CORS (URL desde donde se abre el cliente) ---
CORS_ORIGIN=http://localhost

# --- Memoria de la JVM ---
JAVA_OPTS=-Xms256m -Xmx1g
